# ==============================================================================
# SupplySync Enterprise WMS - Environment Configuration Template
# Salin berkas ini menjadi .env sebelum menjalankan aplikasi dalam lingkungan produksi
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (MySQL 8.0+ InnoDB Required)
DB_HOST=localhost
DB_PORT=3306
DB_USER=supplysync_app
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!
DB_NAME=supplysync_db
DB_CONNECTION_LIMIT=20

# Enterprise Security & Cryptography
# WAJIB diisi dengan random string minimal 32 karakter pada produksi (misal: openssl rand -hex 32)
JWT_SECRET=GantiDenganRandomSecretMinimal32KarakterPadaProduksi
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Automated Initial Admin Provisioning (Opsional untuk First Setup)
INITIAL_ADMIN_EMAIL=admin@supplysync.local
INITIAL_ADMIN_PASSWORD=GantiPasswordAdminAwal123!
