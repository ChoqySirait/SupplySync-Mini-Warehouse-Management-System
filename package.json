{
  "name": "supplysync-mini-warehouse-management-system",
  "version": "1.1.0",
  "description": "Enterprise Mini Warehouse Management System (WMS) with Automated FEFO Batch Allocation and Real-Time Audit Trail Logging",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test tests/**/*.test.js",
    "db:init": "node database/init.js",
    "db:fresh": "node database/init.js --fresh",
    "db:seed": "node database/seed.js",
    "db:migrate": "node database/migrator.js",
    "db:migrate:status": "node database/migrator.js --status",
    "db:backup": "node scripts/dbBackup.js --backup",
    "db:verify": "node scripts/dbBackup.js --verify",
    "db:restore": "node scripts/dbBackup.js --restore",
    "build:frontend": "npm run build --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChoqySirait/SupplySync-Mini-Warehouse-Management-System.git"
  },
  "keywords": [
    "wms",
    "warehouse-management-system",
    "inventory",
    "fefo",
    "fifo",
    "audit-trail",
    "batch-tracking",
    "express",
    "mysql"
  ],
  "author": "SupplySync Engineering Team",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ChoqySirait/SupplySync-Mini-Warehouse-Management-System/issues"
  },
  "homepage": "https://github.com/ChoqySirait/SupplySync-Mini-Warehouse-Management-System#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
